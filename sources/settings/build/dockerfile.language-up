FROM debian:12-slim

ENV ORIGINAL_DIR=/usr/language/java
ENV USER_PROGRAMS=/home/docker/language
ENV EXECUTABLE_PATH=/bin
ENV LANGUAGE_URL=https://download.java.net/java/GA/jdk11/9/GPL/openjdk-11.0.2_linux-x64_bin.tar.gz

RUN echo "Installing base packages and creating a user !!"

RUN apt-get update -y && apt-get upgrade -y \
    && apt-get install -y sudo passwd bash curl unzip xz-utils zip ca-certificates tar   \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m docker \
    && echo "docker:docker" | chpasswd \
    && usermod -aG sudo docker

RUN mkdir -p $ORIGINAL_DIR \
    && curl -L -o /tmp/openjdk.tar.gz $LANGUAGE_URL \
    && tar -xzf /tmp/openjdk.tar.gz -C $ORIGINAL_DIR --strip-components=1 \
    && rm /tmp/openjdk.tar.gz

ENV JAVA_HOME=$ORIGINAL_DIR
ENV PATH=$JAVA_HOME/bin:$PATH

WORKDIR $USER_PROGRAMS

USER docker